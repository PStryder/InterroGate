# InterroGate Environment Configuration

# Server
INTERROGATE_HOST=0.0.0.0
INTERROGATE_PORT=8000
INTERROGATE_DEBUG=false

# Instance identity
INTERROGATE_INSTANCE_ID=interrogate-1

# External services
INTERROGATE_METAGATE_URL=http://localhost:8004
INTERROGATE_MEMORYGATE_URL=http://localhost:8001

# Policy cache
INTERROGATE_POLICY_CACHE_TTL_SECONDS=300
INTERROGATE_POLICY_CACHE_MAX_SIZE=100

# Rate limiting
INTERROGATE_RATE_LIMIT_ENABLED=true
INTERROGATE_RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# Forwarding
INTERROGATE_FORWARD_TIMEOUT_SECONDS=30.0
INTERROGATE_FORWARD_RETRIES=2

# Default policy (fallback if MetaGate unavailable)
INTERROGATE_DEFAULT_MAX_SPAWN_DEPTH=10
INTERROGATE_DEFAULT_MAX_REPEATS_PER_CAPABILITY=5

# Authentication
# API key for REST endpoint authentication (use ig_ prefix by convention)
INTERROGATE_API_KEY=ig_your-secret-api-key-here

# Allow insecure dev mode - ONLY for local development
INTERROGATE_ALLOW_INSECURE_DEV=false
